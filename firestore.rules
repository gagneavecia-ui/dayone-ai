rules_version = '2';

// DAYONE AI — strict per-user Firestore security rules.
// The Firebase Admin SDK (server routes) bypasses these rules by design;
// they exist to constrain every CLIENT access path.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerField(uid) {
      return isSignedIn() && request.resource.data.ownerId == uid;
    }

    function isOwnerDoc(uid) {
      return isSignedIn() && resource.data.ownerId == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'super_admin');
    }

    // ----------------------------- Users -----------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false; // No client-side listing of users.
      allow create: if isOwnerField(userId);
      allow update: if request.auth.uid == userId
        // Plan escalations can never come from the client.
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['plan']));
      allow delete: if request.auth.uid == userId;

      // Daily usage counters (readable by the owner, written by server/client).
      match /usage/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subscription record: readable by the owner, only writable by backend.
      match /subscription/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // ----------------------------- Goals -----------------------------
    match /goals/{goalId} {
      allow read: if isOwnerDoc(request.auth.uid);
      allow create: if isOwnerField(request.auth.uid)
        && request.resource.data.status in ['active', 'archived'];
      allow update, delete: if isOwnerDoc(request.auth.uid);
    }

    // ---------------------------- Missions ---------------------------
    match /missions/{missionId} {
      allow read: if isOwnerDoc(request.auth.uid);
      allow create: if isOwnerField(request.auth.uid)
        && request.resource.data.status in ['todo', 'in_progress', 'done', 'postponed'];
      allow update, delete: if isOwnerDoc(request.auth.uid);
    }

    // --------------------------- Daily plans -------------------------
    match /dailyPlans/{planId} {
      allow read: if isOwnerDoc(request.auth.uid);
      allow create, update: if isOwnerField(request.auth.uid);
      allow delete: if isOwnerDoc(request.auth.uid);
    }

    // ------------------------ Daily reviews --------------------------
    match /dailyReviews/{reviewId} {
      allow read: if isOwnerDoc(request.auth.uid);
      allow create, update: if isOwnerField(request.auth.uid);
      allow delete: if isOwnerDoc(request.auth.uid);
    }

    // ------------------------- Conversations -------------------------
    match /conversations/{conversationId} {
      allow read, update, delete: if isOwnerDoc(request.auth.uid);
      allow create: if isOwnerField(request.auth.uid);

      match /messages/{messageId} {
        function conversationOwner() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId;
        }
        allow read, create, delete: if isSignedIn() && conversationOwner() == request.auth.uid;
      }
    }

    // --------------------------- Feedback ----------------------------
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isOwnerField(request.auth.uid);
      allow update, delete: if false;
    }

    // ------------------------- Administration ------------------------
    match /adminUsers/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow write: if false; // Admins are managed with the Admin SDK scripts only.
    }

    match /systemConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if false; // Only the backend writes configuration, with audit.
    }

    match /globalMetrics/{metricId} {
      allow read: if isAdmin();
      allow write: if false; // Written exclusively by server routes.
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only, tamper-resistant.
    }

    // --------------------------- Deny all ----------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
